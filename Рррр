	end
	local iRed, iCyan, iMain = introLabel(C.accent, 101), introLabel(C.accent2, 101), introLabel(C.text, 102)

	local sub = new("TextLabel", { Text = "murder mystery 2 // loading", Font = FONT, TextSize = 14, TextColor3 = C.dim,
		BackgroundTransparency = 1, TextTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.45, 42), Size = UDim2.fromOffset(400, 20), ZIndex = 102 }, intro)


		Position = UDim2.new(0.5, 0, 0.45, 70), BackgroundColor3 = C.off, BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 102 }, intro)
	corner(barBg, 2)
	local barFill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent,
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 103 }, barBg)
	corner(barFill, 2)

	-- glitch-анимация надписи
	task.spawn(function()
		while active do
			task.wait(0.04)
			local burst = rng:NextNumber() < 0.3
			local off = burst and rng:NextInteger(4, 10) or 2
			iRed.Position = UDim2.new(0.5, -off, 0.45, rng:NextInteger(-2, 2))
			iCyan.Position = UDim2.new(0.5, off, 0.45, rng:NextInteger(-2, 2))
			iMain.Position = UDim2.fromScale(0.5, 0.45)
			local t = {}
			for i = 1, shown do
				local ch = NAME:sub(i, i)
				if burst and ch ~= " " and rng:NextNumber() < 0.3 then
					local r = rng:NextInteger(1, #chars)
					ch = chars:sub(r, r)
				end
				t[i] = ch
			end
			local txt = table.concat(t)
			iRed.Text, iCyan.Text, iMain.Text = txt, txt, txt
		end
	end)

	local fi = TweenInfo.new(0.3)
	TweenService:Create(intro, fi, { BackgroundTransparency = 0.25 }):Play()
	TweenService:Create(iMain, fi, { TextTransparency = 0 }):Play()
	TweenService:Create(iRed, fi, { TextTransparency = 0.35 }):Play()
	TweenService:Create(iCyan, fi, { TextTransparency = 0.35 }):Play()
	TweenService:Create(sub, fi, { TextTransparency = 0 }):Play()
	TweenService:Create(barBg, fi, { BackgroundTransparency = 0 }):Play()

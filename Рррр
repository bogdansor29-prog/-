--// GLITCH EFFECTS
local chars = "!<>-_\\/[]{}=+*^?#01"
local base = "GLITCH HUB"
local rng = Random.new()

task.spawn(function()
	while gui.Parent do
		task.wait(0.05)
		local burst = rng:NextNumber() < 0.15

		-- title RGB split
		local off = burst and rng:NextInteger(3, 7) or 1
		tRed.Position = UDim2.new(0, 80 - off, 0, rng:NextInteger(-1, 1))
		tCyan.Position = UDim2.new(0, 80 + off, 0, rng:NextInteger(-1, 1))
		tMain.Position = UDim2.new(0, 80, 0, 0)

		-- title scramble
		local txt = base
		if burst then
			local t = {}
			for i = 1, #base do
				local ch = base:sub(i, i)
				if ch ~= " " and rng:NextNumber() < 0.35 then
					local r = rng:NextInteger(1, #chars)
					ch = chars:sub(r, r)
				end
				t[i] = ch
			end
			txt = table.concat(t)
		end
		tRed.Text, tCyan.Text, tMain.Text = txt, txt, txt

		-- random glitch slice
		if burst then
			slice.Position = UDim2.new(0.5, rng:NextInteger(-8, 8), rng:NextNumber(), 0)
			slice.Size = UDim2.new(1, -24, 0, rng:NextInteger(2, 12))
			slice.BackgroundColor3 = rng:NextNumber() < 0.5 and C.accent or C.accent2
			slice.BackgroundTransparency = 0.7
			side.Position = UDim2.fromOffset(rng:NextInteger(-2, 2), 36)
		else
			slice.BackgroundTransparency = 1
			side.Position = UDim2.fromOffset(0, 36)
		end
	end
end)

-- scanline + border pulse

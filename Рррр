local function toggle(parent, title, desc, key, cb)
	local f = card(parent, 58)
	new("TextLabel", { Text = title, Font = FONT, TextSize = 16, TextColor3 = C.text, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -70, 0, 20), TextXAlignment = Enum.TextXAlignment.Left }, f)
	new("TextLabel", { Text = desc, Font = FONT, TextSize = 12, TextColor3 = C.dim, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -70, 0, 20), TextXAlignment = Enum.TextXAlignment.Left }, f)
	local sw = new("TextButton", { Text = "", Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -54, 0.5, -11),
		BackgroundColor3 = C.off, AutoButtonColor = false, BorderSizePixel = 0 }, f)
	corner(sw, 11)
	local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = C.text, BorderSizePixel = 0 }, sw)
	corner(knob, 8)
	sw.MouseButton1Click:Connect(function()
		State[key] = not State[key]
		local on = State[key]
		TweenService:Create(sw, TweenInfo.new(0.15), { BackgroundColor3 = on and C.accent or C.off }):Play()
		TweenService:Create(knob, TweenInfo.new(0.15), { Position = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3) }):Play()
		if cb then cb(on) end
	end)
end

local function slider(parent, title, min, max, default, key, cb)
	local f = card(parent, 62)
	local lbl = new("TextLabel", { Text = title .. ": " .. default, Font = FONT, TextSize = 16, TextColor3 = C.text,
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left }, f)
	local bar = new("Frame", { Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 38),
		BackgroundColor3 = C.off, BorderSizePixel = 0 }, f)
	corner(bar, 4)
	local fill = new("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = C.accent, BorderSizePixel = 0 }, bar)
	corner(fill, 4)
	local dragging = false
	local function set(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * a)
		fill.Size = UDim2.new(a, 0, 1, 0)
		lbl.Text = title .. ": " .. v
		State[key] = v
		if cb then cb(v) end
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; set(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			set(i.Position.X)
		end
	end)
end

--// Jump logic
local function hum()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function applyJump()
	local h = hum()
	if not h then return end
	h.UseJumpPower = true
	h.JumpPower = State.SuperJump and State.JumpPower or DefaultJumpPower
end

RunService.Stepped:Connect(function()
	if not State.AutoJump then return end
	local h = hum()
	if not h or h.Health <= 0 then return end
	local s = h:GetState()
	if s ~= Enum.HumanoidStateType.Jumping and s ~= Enum.HumanoidStateType.Freefall
		and s ~= Enum.HumanoidStateType.Dead and not h.Sit then
		h:ChangeState(Enum.HumanoidStateType.Jumping)
		h.Jump = true
	end
end)

lp.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid")
	task.wait(0.5)
	applyJump()
end)


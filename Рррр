	local t = 0
	while gui.Parent do
		local dt = RunService.RenderStepped:Wait()
		t += dt
		scan.Position = UDim2.new(0.5, 0, (t * 0.4) % 1, 0)
		stroke.Color = C.accent:Lerp(C.accent2, (math.sin(t * 2) + 1) / 2)
	end
end)

--// INTRO: надпись с названием при загрузке
main.Visible = false

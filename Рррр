local pages, tabs = {}, {}
local function makePage(name)
	local p = new("ScrollingFrame", { Name = name, Size = UDim2.new(1, -126, 1, -52), Position = UDim2.fromOffset(118, 44),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.accent,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false }, main)
	new("UIListLayout", { Padding = UDim.new(0, 8) }, p)
	pages[name] = p
	local b = new("TextButton", { Text = "  " .. name, Font = FONT, TextSize = 15, TextColor3 = C.dim,
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.bg, BorderSizePixel = 0,
		TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false }, side)
	corner(b, 8)
	tabs[name] = b
	b.MouseButton1Click:Connect(function()
		for n, pg in pairs(pages) do pg.Visible = (n == name) end
		for n, bt in pairs(tabs) do
			TweenService:Create(bt, TweenInfo.new(0.2), { TextColor3 = n == name and C.text or C.dim,
				BackgroundColor3 = n == name and C.panel or C.bg }):Play()
		end
	end)
	return p
end

local function card(parent, h)
